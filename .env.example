# Postgres (Neon). Obrigatória em produção na Vercel.
# A integração Neon preenche DATABASE_URL ou POSTGRES_URL.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Área administrativa, separada da consulta pública.
# Não commitar senha nem segredo reais.
ADMIN_USER=cepmmif
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
